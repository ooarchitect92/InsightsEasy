{
  "name": "insightseasy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web"],
  "engines": {"node": ">=22.16.0 <25"},
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "npm run build --workspace @insightseasy/web",
    "build": "npm run build:server && npm run build:web",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "dev": "node scripts/dev.mjs",
    "test:components": "node scripts/test-components.mjs",
    "test:providers": "node scripts/test-providers.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-fastify": "11.2.5",
    "amqplib": "0.10.9",
    "bullmq": "5.61.2",
    "fastify": "5.12.1",
    "ioredis": "5.7.0",
    "kafkajs": "2.2.4",
    "mongodb": "6.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/amqplib": "0.10.7",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "yaml": "2.9.1"
  },
  "overrides": {"fastify": "5.12.1"}
}
